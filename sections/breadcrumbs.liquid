{%- comment -%}
  FRANKY'S (TLF) — Priority 8: breadcrumbs.
  Home › Collection            (collection pages)
  Home › Collection › Product  (product pages)
  Home › Placemats › Navy      (P4: colour templates, category set in this section's settings)
  The collection on product pages is chosen by snippets/breadcrumb-collection-handle.liquid.
{%- endcomment -%}
{%- liquid
  assign crumb_collection = nil

  capture crumb_handle
    render 'breadcrumb-collection-handle', product: product, collection: collection
  endcapture
  assign crumb_handle = crumb_handle | strip

  if crumb_handle != blank
    assign crumb_collection = collections[crumb_handle]
  endif

  # FRANKY'S (TLF) P4: parent crumb for the colour collections
  # Each Shop by Colour template (colour = placemats & coasters, colour-bedding, colour-bath)
  # names its category in this section's settings, so the trail reads Home › Bedding › Navy.
  assign crumb_parent = nil
  assign crumb_parent_title = ''
  if request.page_type == 'collection' and template.suffix contains 'colour'
    if section.settings.colour_parent != blank
      assign crumb_parent = section.settings.colour_parent
      assign crumb_parent_title = section.settings.colour_parent_label
    else
      # No category set: fall back to the product type filter in the URL
      # (?filter.p.product_type=Bedding), then the all-colours collection.
      assign scope_type = ''
      for filter in collection.filters
        if filter.param_name == 'filter.p.product_type' and filter.active_values.size > 0
          assign scope_type = filter.active_values.first.value
        endif
      endfor

      if scope_type != blank
        assign scope_handle = scope_type | handleize
        assign map_lines = section.settings.colour_category_map | newline_to_br | split: '<br />'
        for map_line in map_lines
          assign map_parts = map_line | strip | split: '='
          if map_parts.size == 2
            assign map_type = map_parts[0] | strip
            if map_type == scope_type
              assign scope_handle = map_parts[1] | strip
            endif
          endif
        endfor

        assign crumb_parent = collections[scope_handle]
      elsif collection.handle != 'shop-by-colour'
        assign crumb_parent = collections['shop-by-colour']
      endif
    endif

    if crumb_parent.id == blank
      assign crumb_parent = nil
    endif
  endif
-%}

{%- if request.page_type == 'product' or request.page_type == 'collection' -%}
  <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
    <nav class="breadcrumbs container" aria-label="Breadcrumb">
      <ol class="breadcrumbs__list unstyled-list text-xs">
        <li class="breadcrumbs__item">
          <a href="{{ routes.root_url }}" class="breadcrumbs__link">{{ 'general.home' | t }}</a>
        </li>

        {%- if crumb_parent -%}
          <li class="breadcrumbs__item">
            <a href="{{ crumb_parent.url }}" class="breadcrumbs__link">{{ crumb_parent_title | default: crumb_parent.title }}</a>
          </li>
        {%- endif -%}

        {%- if crumb_collection -%}
          <li class="breadcrumbs__item">
            {%- if request.page_type == 'collection' -%}
              <span class="breadcrumbs__current" aria-current="page">{{ crumb_collection.title }}</span>
            {%- else -%}
              <a href="{{ crumb_collection.url }}" class="breadcrumbs__link">{{ crumb_collection.title }}</a>
            {%- endif -%}
          </li>
        {%- endif -%}

        {%- if request.page_type == 'product' -%}
          <li class="breadcrumbs__item">
            <span class="breadcrumbs__current" aria-current="page">{{ product.title }}</span>
          </li>
        {%- endif -%}
      </ol>
    </nav>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Breadcrumbs",
  "class": "shopify-section--breadcrumbs",
  "enabled_on": {
    "templates": ["product", "collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "On product pages the middle link is the collection the shopper came from, otherwise the product's main category range."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Shop by Colour pages"
    },
    {
      "type": "collection",
      "id": "colour_parent",
      "label": "Category link",
      "info": "FRANKY'S (TLF) P4. On Shop by Colour templates, the middle link (e.g. Home › Bedding › Navy)."
    },
    {
      "type": "text",
      "id": "colour_parent_label",
      "label": "Category link text",
      "info": "Defaults to the collection title."
    },
    {
      "type": "textarea",
      "id": "colour_category_map",
      "label": "Shop by Colour category links",
      "info": "Used when Category link is empty. On colour pages filtered to a product type, the middle link goes to the collection with the same handle as the type. List exceptions one per line as Product type=collection-handle, e.g. Coasters=placemats.",
      "default": "Placemats=placemats\nCoasters=placemats"
    }
  ],
  "presets": [
    {
      "name": "Breadcrumbs"
    }
  ]
}
{% endschema %}
