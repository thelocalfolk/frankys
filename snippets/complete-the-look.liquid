{%- doc -%}
  FRANKY'S (TLF) PDP: "Complete the look" from the Figma product page, working like the set-builder prototype
  (claude.ai/artifact/ADqAhj5Nx8mm817ux7Aswt). Each row is a product category (placemats, coasters, napkins, tablecloth,
  cutlery). Ticking a row adds a matching piece; the row then opens to change quantity, range and colour. The Total
  above the button includes ticked rows, and Add to Cart adds everything in one request.

  This snippet only outputs the rows and their product data; assets/frankys-complete-the-look.js does the picking:
    - Colour follows the product's chosen colour. Same range first (Lorient Placemat -> Lorient Coaster), then the
      cheapest range made in that exact colour, then the range with the closest colour (by swatch). Rows outside the
      product's range are marked "Mix".
    - Ranges are the first word of the product name, so the three Peru Cutlery Set products are one range.
    - Quantity options come from how many place settings one piece covers: the row's "Covers" setting, a "Set of N"
      in the product name, or the product metafield custom.builder_covers_settings (same as the table builder).
  Rows whose collection holds the current product are hidden (no "Placemats" row on a placemat).

  @param {object} product - the product whose page this is
  @param {object} block - the complete_the_look block
  @param {string} form_id - id of the product form the pieces are added with
{%- enddoc -%}

{%- liquid
  assign colour_names = 'color,colour' | split: ','
  assign current_variant = product.selected_or_first_available_variant
  assign product_collection_handles = product.collections | map: 'handle'

  # ---- Chosen colour and its swatch -----------------------------------------------------------------------------
  assign hero_colour = ''
  assign hero_swatch = ''
  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    if colour_names contains option_name
      assign hero_colour = current_variant.options[forloop.index0]
      for value in option.values
        if value == hero_colour
          capture hero_swatch
            render 'setting-builder-swatch', value: value
          endcapture
          break
        endif
      endfor
      break
    endif
  endfor

  assign hero_range = product.title | split: ' ' | first | downcase
-%}

{%- capture rows -%}
  {%- for i in (1..5) -%}
    {%- liquid
      assign collection_key = 'item_' | append: i | append: '_collection'
      assign row_collection = block.settings[collection_key]
      if row_collection == blank or product_collection_handles contains row_collection.handle
        continue
      endif

      # "From" price: the cheapest available product in the row's collection
      assign from_price = nil
      assign product_count = 0
      for candidate in row_collection.products limit: 40
        if candidate.available == false or candidate.id == product.id
          continue
        endif
        assign product_count = product_count | plus: 1
        if from_price == nil or candidate.price_min < from_price
          assign from_price = candidate.price_min
        endif
      endfor

      if product_count == 0
        continue
      endif

      assign label_key = 'item_' | append: i | append: '_label'
      assign icon_key = 'item_' | append: i | append: '_icon'
      assign image_key = 'item_' | append: i | append: '_image'
      assign covers_key = 'item_' | append: i | append: '_covers'

      assign label = block.settings[label_key] | default: row_collection.title
      assign icon = block.settings[icon_key]
      assign image = block.settings[image_key]
      assign covers = block.settings[covers_key] | default: 1, allow_false: true
      assign from_price_money = from_price | money
      assign input_id = 'complete-the-look-' | append: block.id | append: '-' | append: i
    -%}

    <li class="complete-the-look__row" data-row="{{ i }}">
      <script type="application/json" data-row-products>
        {
          "covers": {{ covers | json }},
          "products": [
            {%- assign first = true -%}
            {%- for candidate in row_collection.products limit: 40 -%}
              {%- if candidate.available == false or candidate.id == product.id -%}{%- continue -%}{%- endif -%}
              {%- unless first -%},{%- endunless -%}
              {%- render 'setting-builder-product-json', product: candidate -%}
              {%- assign first = false -%}
            {%- endfor -%}
          ]
        }
      </script>

      <div class="complete-the-look__head">
        <input type="checkbox" class="checkbox" id="{{ input_id }}" data-row-toggle>
        <label class="complete-the-look__label" for="{{ input_id }}">
          <span class="complete-the-look__icon" aria-hidden="true">
            {%- if image != blank -%}
              {{- image | image_url: width: 96 | image_tag: width: 32, height: 32, loading: 'lazy', alt: '' -}}
            {%- elsif icon != blank and icon != 'none' -%}
              {%- assign icon_file = 'frankys-icon-' | append: icon | append: '.svg' -%}
              {{- icon_file | inline_asset_content -}}
            {%- endif -%}
          </span>
          <span class="complete-the-look__name">{{ label | escape }}</span>
          <span class="complete-the-look__price" data-row-price>{{ 'product.price.from_price_html' | t: price_min: from_price_money }}</span>
        </label>
      </div>

      <div class="complete-the-look__options" data-row-options hidden></div>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- assign rows = rows | strip -%}
{%- if rows != blank -%}
  <complete-the-look
    class="complete-the-look"
    form="{{ form_id | escape }}"
    data-hero-range="{{ hero_range | escape }}"
    data-hero-colour="{{ hero_colour | escape }}"
    data-hero-swatch="{{ hero_swatch | strip | escape }}"
    {{ block.shopify_attributes }}
  >
    <script type="application/json" data-look-config>
      {
        "moneyFormat": {{ shop.money_format | json }},
        "strings": {
          "range": {{ 'product.complete_the_look.range' | t | json }},
          "colour": {{ 'product.complete_the_look.colour' | t | json }},
          "quantity": {{ 'product.complete_the_look.quantity' | t | json }},
          "mix": {{ 'product.complete_the_look.mix' | t | json }},
          "inColour": {{ 'product.complete_the_look.in_colour' | t: range: '{range}', colour: '{colour}' | json }},
          "closestColour": {{ 'product.complete_the_look.closest_colour' | t: range: '{range}', colour: '{colour}' | json }},
          "setOf": {{ 'product.complete_the_look.set_of' | t: count: '{count}' | json }},
          "sets": {{ 'product.complete_the_look.sets' | t: count: '{count}' | json }},
          "oneSet": {{ 'product.complete_the_look.one_set' | t | json }},
          "one": {{ 'product.complete_the_look.one' | t | json }},
          "two": {{ 'product.complete_the_look.two' | t | json }}
        }
      }
    </script>

    <fieldset class="complete-the-look__fieldset">
      {%- if block.settings.title != blank -%}
        <legend class="complete-the-look__title">{{ block.settings.title | escape }}</legend>
      {%- endif -%}
      <ul class="complete-the-look__list" role="list">
        {{- rows -}}
      </ul>
    </fieldset>
  </complete-the-look>

  <script src="{{ 'frankys-complete-the-look.js' | asset_url }}" defer></script>
{%- endif -%}
