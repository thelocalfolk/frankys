{%- doc -%}
Renders disclosure titles and symbols inline in a cart line item.

@param {object} product - the line item's product
{%- enddoc -%}

{%- assign disclosures = product.metafields.shopify.disclosure.value -%}

{%- if disclosures != blank -%}
  {%- capture cart_disclosures_content -%}
    {%- for disclosure in disclosures -%}
      {%- if disclosure.display_preferences.value.surfaces contains 'cart' -%}
        {%- assign disclosure_title = disclosure.title.value -%}
        {%- assign img = disclosure.symbol.value -%}

        <div class="h-stack gap-1 subheading text-subdued">
          {%- if img != blank -%}
            {%- render 'icon', image: img, width: 16, mobile_width: 16 -%}
          {%- endif -%}
          <span>{{ disclosure_title | escape }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if cart_disclosures_content != blank -%}
    <div class="v-stack gap-1">
      {{- cart_disclosures_content -}}
    </div>
  {%- endif -%}
{%- endif -%}
