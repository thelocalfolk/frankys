{%- doc -%}
  FRANKY'S x Judge.me - custom-styled product reviews section.

  Embeds Judge.me's native review widget and reskins it to match the theme. Judge.me
  keeps handling the data, photos, verified badges, helpful voting, sorting and
  pagination (no API tokens, nothing to maintain, survives Judge.me updates); this
  section controls the look and the Maestrooo section conventions around it.

  Setup (once):
    1. Judge.me > Settings > Installation: turn OFF the automatic "Review widget"
       placement so it doesn't render twice, then add THIS section to the product
       template in the theme editor (Add section > "Product reviews").
    2. Optional: Judge.me > Customize widget - set widget layout to a clean/minimal
       preset; this CSS handles the styling on top.

  @param {object} [section]
{%- enddoc -%}

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="section-spacing">
    <div class="container">
      <div class="frk-reviews" style="--frk-star-color: {{ section.settings.star_color }}; --frk-reviews-max-width: {{ section.settings.content_max_width }}px;">
        {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
          <div class="prose prose-justify-{{ section.settings.heading_alignment }} frk-reviews__intro">
            {%- if section.settings.subheading != blank -%}
              <p class="subheading">{{ section.settings.subheading }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Native Judge.me review widget - reskinned by the stylesheet below {%- endcomment -%}
        <div id="judgeme_product_reviews"
             class="jdgm-widget jdgm-review-widget"
             data-product-title="{{ product.title | escape }}"
             data-id="{{ product.id }}"></div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
/* ==========================================================================
   FRANKY'S reskin of the Judge.me review widget. Scoped to .frk-reviews so it
   never touches the rating badge in the product header. Uses the theme's colour
   tokens so it tracks every colour scheme; stars use the section's star colour.
   ========================================================================== */
.frk-reviews {
  --jdgm-primary-color: var(--frk-star-color);
  max-width: var(--frk-reviews-max-width, 1000px);
  margin-inline: auto;
}
.frk-reviews__intro { margin-bottom: 1.75rem; }

/* hide Judge.me's own duplicate header/title; we provide the section heading */
.frk-reviews .jdgm-rev-widg__title { display: none; }

/* ---- stars ---- */
.frk-reviews .jdgm-star { font-size: 15px; }
.frk-reviews .jdgm-star.jdgm--on,
.frk-reviews .jdgm-star.jdgm--half { color: var(--frk-star-color); }
.frk-reviews .jdgm-star.jdgm--off { color: rgb(var(--text-color) / 0.22); }

/* ---- summary + histogram ---- */
.frk-reviews .jdgm-rev-widg__summary {
  background: rgb(var(--background));
  border: 1px solid rgb(var(--text-color) / 0.12);
  border-radius: 14px;
  padding: 1.5rem 1.75rem;
  margin-bottom: 1.25rem;
  text-align: start;
}
.frk-reviews .jdgm-rev-widg__summary-average {
  font-weight: 600;
  letter-spacing: -0.02em;
  color: rgb(var(--text-color));
}
.frk-reviews .jdgm-rev-widg__summary-text {
  font-size: 0.8125rem;
  color: rgb(var(--text-color) / 0.65);
}
.frk-reviews .jdgm-histogram__row { align-items: center; }
.frk-reviews .jdgm-histogram__bar {
  background: rgb(var(--text-color) / 0.08);
  border-radius: 999px;
  overflow: hidden;
  height: 6px;
}
.frk-reviews .jdgm-histogram__bar-content {
  background: var(--frk-star-color);
  border-radius: 999px;
}
.frk-reviews .jdgm-histogram__frequency { color: rgb(var(--text-color) / 0.6); }

/* ---- write-a-review button -> pill ---- */
.frk-reviews .jdgm-write-rev-link {
  display: inline-block;
  background: transparent;
  color: rgb(var(--text-color));
  border: 1px solid rgb(var(--text-color));
  border-radius: 999px;
  padding: 0.6rem 1.4rem;
  font: inherit;
  font-size: 0.8125rem;
  text-transform: none;
  transition: background 0.15s ease, color 0.15s ease;
}
.frk-reviews .jdgm-write-rev-link:hover {
  background: rgb(var(--text-color));
  color: rgb(var(--background));
}

/* ---- sort dropdown -> pill ---- */
.frk-reviews .jdgm-sort-dropdown,
.frk-reviews .jdgm-rev-widg__sort-wrapper select {
  border: 1px solid rgb(var(--text-color) / 0.16);
  border-radius: 999px;
  padding: 0.44rem 0.9rem;
  font-size: 0.8125rem;
  background: transparent;
  color: rgb(var(--text-color));
}

/* ---- individual review cards ---- */
.frk-reviews .jdgm-rev-widg__reviews {
  display: grid;
  gap: 0;
  background: rgb(var(--background));
  border: 1px solid rgb(var(--text-color) / 0.12);
  border-radius: 14px;
  overflow: hidden;
}
.frk-reviews .jdgm-rev {
  border: 0;
  border-bottom: 1px solid rgb(var(--text-color) / 0.1);
  padding: 1.4rem 1.6rem;
  margin: 0;
}
.frk-reviews .jdgm-rev:last-child { border-bottom: 0; }
.frk-reviews .jdgm-rev__author {
  font-weight: 600;
  font-size: 0.85rem;
  color: rgb(var(--text-color));
}
.frk-reviews .jdgm-rev__timestamp {
  font-size: 0.72rem;
  color: rgb(var(--text-color) / 0.55);
}
.frk-reviews .jdgm-rev__title {
  font-weight: 600;
  font-size: 0.95rem;
  margin-top: 0.4rem;
  color: rgb(var(--text-color));
}
.frk-reviews .jdgm-rev__body {
  font-size: 0.85rem;
  line-height: 1.6;
  color: rgb(var(--text-color) / 0.82);
}

/* verified-buyer badge -> sage pill */
.frk-reviews .jdgm-rev__buyer-badge {
  color: #6f8268;
  font-weight: 600;
}
.frk-reviews .jdgm-rev__buyer-badge .jdgm-rev__buyer-badge-tooltip { font-weight: 400; }

/* review photos -> rounded */
.frk-reviews .jdgm-rev__pic-img,
.frk-reviews .jdgm-rev__pics img {
  border-radius: 10px;
  object-fit: cover;
}

/* helpful (thumbs) buttons -> subtle pills */
.frk-reviews .jdgm-rev__thumb-btn,
.frk-reviews .jdgm-rev__actions .jdgm-rev__thumb-btns {
  border: 1px solid rgb(var(--text-color) / 0.14);
  border-radius: 999px;
}
.frk-reviews .jdgm-rev__action {
  color: rgb(var(--text-color) / 0.6);
  font-size: 0.72rem;
}

/* ---- pagination ---- */
.frk-reviews .jdgm-paginate__page {
  color: rgb(var(--text-color) / 0.6);
  border-radius: 999px;
}
.frk-reviews .jdgm-paginate__page.jdgm-curr-page,
.frk-reviews .jdgm-paginate__page:hover {
  background: rgb(var(--text-color));
  color: rgb(var(--background));
}

/* a touch of breathing room on mobile */
@media (max-width: 699px) {
  .frk-reviews .jdgm-rev { padding: 1.1rem 1.1rem; }
  .frk-reviews .jdgm-rev-widg__summary { padding: 1.25rem; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Product reviews",
  "class": "shopify-section--product-reviews",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "FRANKY'S: embeds and reskins the Judge.me review widget. Turn OFF Judge.me's automatic widget placement (Judge.me > Settings > Installation) so it doesn't render twice."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star colour",
      "default": "#C56A3F"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Reviews"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by our customers"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "display-m", "label": "Display M" },
        { "value": "h1", "label": "XX-Large" },
        { "value": "h2", "label": "X-Large" },
        { "value": "h3", "label": "Large" },
        { "value": "h4", "label": "Medium" }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Max width",
      "min": 700,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 1000
    }
  ],
  "presets": [
    { "name": "Product reviews" }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}