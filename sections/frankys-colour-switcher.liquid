{%- comment -%}
  FRANKY'S (TLF) P4: Shop by Colour, page header + colour switcher.
  Used by templates/collection.colour.json (placemats & coasters, assigned to the 16 colour
  collections and the all-colours collection shop-by-colour), and by
  collection.colour-bedding.json and collection.colour-bath.json (reached with ?view=).

  - Every tile is a real <a href> to its collection, so the switcher works and is
    crawlable without JavaScript. assets/frankys-colour-switcher.js enhances it to
    swap the heading, filters and grid in place (Section Rendering API).
  - The tile for the current collection gets aria-current="page". On the
    all-colours page no tile matches, so none is highlighted.
  - SEO: the h1 on every page is collection.title. On a colour page "Shop by Colour"
    is styled text, not a heading; on the all-colours page it is the h1.
{%- endcomment -%}
{%- liquid
  assign is_all_colours = false
  if collection.handle == 'shop-by-colour'
    assign is_all_colours = true
  endif

  assign tile_desktop_vw = 100.0 | divided_by: section.settings.tiles_per_row_desktop

  # Category scope: Shop by Colour always works inside one category (placemats & coasters,
  # bedding, bath), set by Shopify's product type filter in the URL, e.g. the Placemats menu
  # links to ?filter.p.product_type=Placemats&filter.p.product_type=Coasters. Tiles carry the
  # same filter so switching colour stays in that category.
  assign scope_query = ''
  assign scope_label = ''
  for filter in collection.filters
    if filter.param_name == 'filter.p.product_type'
      for filter_value in filter.active_values
        assign encoded_value = filter_value.value | url_encode
        assign scope_query = scope_query | append: '&' | append: filter_value.param_name | append: '=' | append: encoded_value
        if scope_label != blank
          assign scope_label = scope_label | append: ' & '
        endif
        assign scope_label = scope_label | append: filter_value.label
      endfor
    endif
  endfor
  # No filter in the URL: use the template's own category (Product types setting), so
  # the bedding template's tiles only ever lead to bedding.
  if scope_query == blank and section.settings.scope_product_types != blank
    assign scope_types = section.settings.scope_product_types | split: ','
    for scope_type in scope_types
      assign scope_type = scope_type | strip
      if scope_type != blank
        assign encoded_value = scope_type | url_encode
        assign scope_query = scope_query | append: '&filter.p.product_type=' | append: encoded_value
      endif
    endfor
  endif

  # Bedding and bath use their own templates (colour-bedding, colour-bath). Colour collections
  # are assigned the placemats one, so tiles keep the others with ?view=.
  assign tile_view = ''
  if template.suffix != blank and template.suffix != 'colour'
    assign tile_view = template.suffix
  endif

  assign tile_query = scope_query
  if tile_view != blank
    assign tile_query = tile_query | append: '&view=' | append: tile_view
  endif

  # Tiles from the collection's own colours (bedding and bath templates): uses the
  # Colour filter from Search & Discovery on the category collection itself.
  assign colour_filter = blank
  if section.settings.tile_source == 'colour_filter'
    for filter in collection.filters
      assign filter_label = filter.label | downcase | strip
      if filter_label == 'colour' or filter_label == 'color' or filter_label == 'colours' or filter_label == 'colors'
        assign colour_filter = filter
        break
      endif
    endfor
  endif

  assign scope_query = scope_query | remove_first: '&'
  assign tile_query = tile_query | remove_first: '&'

  # The category sits in a small eyebrow above "Shop by Colour" (e.g. Placemats & Coasters)
  assign page_title_text = section.settings.title
  assign eyebrow_text = section.settings.eyebrow
  if scope_label != blank and eyebrow_text == blank
    assign eyebrow_text = scope_label
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --colour-switcher-tile-width: {{ section.settings.tile_width_mobile }}vw;
    --colour-switcher-tiles-per-row: {{ section.settings.tiles_per_row_desktop }};
  }
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="container section-spacing colour-switcher">
    <div class="section-stack">
      {%- if section.settings.title != blank or section.settings.intro != blank -%}
        <div class="colour-switcher__intro prose prose-justify-center text-center">
          {%- if eyebrow_text != blank and is_all_colours == false -%}
            <p class="subheading">{{ eyebrow_text | escape }}</p>
          {%- endif -%}

          {%- if section.settings.title != blank -%}
            {%- if is_all_colours -%}
              <h1 class="h3">{{ collection.title | default: section.settings.title }}</h1>
              {%- if scope_label != blank -%}
                <p class="text-sm">{{ scope_label | escape }}</p>
              {%- endif -%}
            {%- else -%}
              <p class="h3">{{ page_title_text | escape }}</p>
            {%- endif -%}
          {%- endif -%}

          {%- if section.settings.intro != blank -%}
            <div class="colour-switcher__intro-text">{{ section.settings.intro }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.tile_source == 'colour_filter' and colour_filter == blank -%}
        {%- if request.design_mode -%}
          <p class="text-sm text-center">No Colour filter found on this collection. Switch on the Colour filter in Search &amp; Discovery to show the colour tiles.</p>
        {%- endif -%}
      {%- elsif section.blocks.size > 0 or colour_filter != blank -%}
        <colour-switcher class="colour-switcher__picker" section-id="{{ section.id }}">
          <div class="frankys-section-header">
            {%- if section.settings.switcher_title != blank -%}
              <h2 class="h5" id="colour-switcher-title-{{ section.id }}">{{ section.settings.switcher_title }}</h2>
            {%- endif -%}

            <div class="colour-switcher__controls h-stack gap-3 sm-max:hidden">
              <button type="button" class="circle-button circle-button--lg" data-colour-switcher-prev>
                <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
                {%- render 'icon' with 'big-arrow-left', direction_aware: true, width: 12 -%}
              </button>

              <button type="button" class="circle-button circle-button--lg" data-colour-switcher-next>
                <span class="sr-only">{{ 'general.accessibility.next' | t }}</span>
                {%- render 'icon' with 'big-arrow-right', direction_aware: true, width: 12 -%}
              </button>
            </div>
          </div>

          <nav class="colour-switcher__list scroll-area snap-x bleed" data-colour-switcher-list {% if section.settings.switcher_title != blank %}aria-labelledby="colour-switcher-title-{{ section.id }}"{% else %}aria-label="{{ section.settings.title | escape }}"{% endif %}>
            {%- capture sizes -%}(max-width: 699px) {{ section.settings.tile_width_mobile }}vw, (max-width: 999px) 26vw, {{ tile_desktop_vw | ceil }}vw{%- endcapture -%}

            {%- if colour_filter != blank -%}
              {%- comment -%}
                Bedding and bath: the tiles are the colours of this collection's products (its Colour
                filter). A Colour block whose label or collection matches a colour gives that tile its
                image and icon; other colours use the colour's swatch.
              {%- endcomment -%}
              {%- for colour_value in colour_filter.values -%}
                {%- if colour_value.count == 0 and colour_value.active == false -%}
                  {%- continue -%}
                {%- endif -%}

                {%- liquid
                  assign colour_handle = colour_value.label | handleize
                  assign colour_block = nil
                  for block in section.blocks
                    assign block_label_handle = block.settings.label | handleize
                    if block_label_handle == colour_handle or block.settings.collection.handle == colour_handle
                      assign colour_block = block
                      break
                    endif
                  endfor

                  assign colour_value_encoded = colour_value.value | url_encode
                  capture colour_href
                    echo collection.url | append: '?' | append: colour_filter.param_name | append: '=' | append: colour_value_encoded
                    if tile_view != blank
                      echo '&view=' | append: tile_view
                    endif
                  endcapture
                -%}

                {%- render 'frankys-colour-tile',
                  href: colour_href,
                  handle: colour_handle,
                  label: colour_value.label,
                  block: colour_block,
                  image: colour_value.image,
                  swatch_color: colour_value.swatch.color,
                  is_current: colour_value.active,
                  sizes: sizes,
                  section: section
                -%}
              {%- endfor -%}
            {%- else -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  assign tile_collection = block.settings.collection
                  if tile_collection == blank
                    continue
                  endif

                  assign is_current = false
                  if tile_collection.handle == collection.handle
                    assign is_current = true
                  endif
                  assign tile_label = block.settings.label | default: tile_collection.title
                -%}

                {%- capture tile_href -%}{{ tile_collection.url }}{% if tile_query != blank %}?{{ tile_query }}{% endif %}{%- endcapture -%}
                {%- render 'frankys-colour-tile',
                  href: tile_href,
                  handle: tile_collection.handle,
                  label: tile_label,
                  block: block,
                  image: tile_collection.featured_image,
                  is_current: is_current,
                  sizes: sizes,
                  section: section
                -%}
              {%- endfor -%}
            {%- endif -%}
          </nav>

          <p class="sr-only" aria-live="polite" data-colour-switcher-status></p>
        </colour-switcher>
      {%- endif -%}
    </div>
  </div>
</div>

<script src="{{ 'frankys-colour-switcher.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Colour switcher",
  "class": "shopify-section--colour-switcher",
  "tag": "section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "FRANKY'S (TLF) P4. Each tile links to a colour collection. On the all-colours collection (handle shop-by-colour) the title below is replaced by the collection title and becomes the page heading."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Page header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Small line above the title naming the category, e.g. Placemats & Coasters."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Shop by Colour"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Start with a colour you love. We’ll take it from there. Explore pieces for every room in complementary shades, designed to mix, match and bring a little more colour into everyday living.</p>"
    },
    {
      "type": "select",
      "id": "tile_source",
      "label": "Tiles",
      "options": [
        { "value": "blocks", "label": "Colour collections (blocks below)" },
        { "value": "colour_filter", "label": "Colours in this collection" }
      ],
      "default": "blocks",
      "info": "Colours in this collection: for a category page like Bath, one tile per colour its products come in (needs the Colour filter in Search & Discovery). Blocks below with a matching label add the image and icon."
    },
    {
      "type": "text",
      "id": "scope_product_types",
      "label": "Product types",
      "info": "Keeps this page to one category, e.g. Placemats, Coasters. Comma separated, spelt exactly as in Shopify. Needs Product type switched on as a filter in Search & Discovery."
    },
    {
      "type": "header",
      "content": "Colour tiles"
    },
    {
      "type": "text",
      "id": "switcher_title",
      "label": "Heading",
      "default": "Choose your colour"
    },
    {
      "type": "color_scheme",
      "id": "tile_color_scheme",
      "label": "Tile text colour scheme",
      "default": "scheme-3"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 10
    },
    {
      "type": "range",
      "id": "tile_width_mobile",
      "label": "Tile width on mobile",
      "info": "Percentage of the screen width. Smaller tiles keep the products closer to the top of the page.",
      "min": 25,
      "max": 85,
      "step": 1,
      "unit": "%",
      "default": 34
    },
    {
      "type": "range",
      "id": "tiles_per_row_desktop",
      "label": "Tiles visible on desktop",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "colour",
      "name": "Colour",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colour collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tile image",
          "info": "Defaults to the theme file below, then the collection image. Square images work best."
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Tile image (theme file)",
          "info": "Filename in the theme's assets folder, e.g. frankys-colour-tile-navy.jpg. Used when Tile image is empty."
        },
        {
          "type": "select",
          "id": "icon_style",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "beige", "label": "Beige (wheat)" },
            { "value": "black", "label": "Black (moon)" },
            { "value": "brown", "label": "Brown (coffee bean)" },
            { "value": "butter", "label": "Butter" },
            { "value": "chocolate", "label": "Chocolate" },
            { "value": "clay", "label": "Clay (pot)" },
            { "value": "dark-green", "label": "Dark Green (tree)" },
            { "value": "dark-grey", "label": "Dark Grey (cloud)" },
            { "value": "light-blue", "label": "Light Blue (waves)" },
            { "value": "milk", "label": "Milk (carton)" },
            { "value": "navy", "label": "Navy (anchor)" },
            { "value": "nude", "label": "Nude (scallop shell)" },
            { "value": "pearl-grey", "label": "Pearl Grey (shell)" },
            { "value": "pink", "label": "Pink (flower)" },
            { "value": "sage-green", "label": "Sage Green (leaf)" },
            { "value": "wine", "label": "Wine (glass)" }
          ],
          "default": "none"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom icon",
          "info": "Used when Icon is None. Transparent PNG exported at Figma size (for a 421px tile); its width sets the icon size."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Defaults to the collection title."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Colour switcher"
    }
  ]
}
{% endschema %}
