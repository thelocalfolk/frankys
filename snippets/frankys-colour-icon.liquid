{%- doc -%}
  FRANKY'S (TLF) P4: line icons for the Shop by Colour tiles.
  Each icon is its own SVG in assets/ (frankys-colour-icon-<name>.svg), drawn in the tile
  text colour with a CSS mask, so it is downloaded once and cached across every colour page
  instead of being inlined into the HTML. Width is a % of the tile, matching the Figma (tile = 421px).
  Chocolate, sage-green, light-blue and butter were traced from the Figma; the rest were traced
  with potrace from Good Manners' PNG exports (15 Oct 2026).

  @param {string} name - beige, black, brown, butter, chocolate, clay, dark-green, light-blue,
    milk, navy, pearl-grey, pink, sage-green or wine
{%- enddoc -%}
{%- liquid
  case name
    when 'beige'
      assign icon_width = '10.2%'
      assign icon_ratio = '492 / 1678'
    when 'black'
      assign icon_width = '27.9%'
      assign icon_ratio = '1048 / 1303'
    when 'brown'
      assign icon_width = '30.0%'
      assign icon_ratio = '1021 / 1181'
    when 'butter'
      assign icon_width = '40.4%'
      assign icon_ratio = '169.998 / 91'
    when 'chocolate'
      assign icon_width = '27.3%'
      assign icon_ratio = '114.998 / 146.002'
    when 'clay'
      assign icon_width = '37.9%'
      assign icon_ratio = '1038 / 951'
    when 'dark-green'
      assign icon_width = '35.2%'
      assign icon_ratio = '1372 / 1352'
    when 'light-blue'
      assign icon_width = '44.4%'
      assign icon_ratio = '186.896 / 78.0084'
    when 'milk'
      assign icon_width = '21.8%'
      assign icon_ratio = '946 / 1503'
    when 'navy'
      assign icon_width = '28.9%'
      assign icon_ratio = '1136 / 1361'
    when 'pearl-grey'
      assign icon_width = '33.6%'
      assign icon_ratio = '1270 / 1311'
    when 'pink'
      assign icon_width = '22.0%'
      assign icon_ratio = '1038 / 1636'
    when 'sage-green'
      assign icon_width = '22.7%'
      assign icon_ratio = '95.5994 / 145.369'
    when 'wine'
      assign icon_width = '13.3%'
      assign icon_ratio = '467 / 800'
    else
      assign icon_width = blank
  endcase
-%}
{%- if icon_width != blank -%}
  {%- assign icon_file = 'frankys-colour-icon-' | append: name | append: '.svg' -%}
  <span class="colour-switcher__icon colour-switcher__icon--mask" style="--icon-width: {{ icon_width }}; --icon-ratio: {{ icon_ratio }}; --icon-url: url('{{ icon_file | asset_url }}');" aria-hidden="true"></span>
{%- endif -%}
